<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%=title%></title>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <h1><%= title %></h1>

    <ul class="game-list">
      <% games.forEach((game) => { %>
        <li class="game">
          <div class="game-title"><%= game.title %></div>
          <div class="genre"><span class="label">Genre</span><span class="value"><%= game.genre %></span></div>
          <div class="developer"><span class="label">Developer</span><span class="value"><%= game.developer %></span></div>
          <div class="year"><span class="label">Year</span><span class="value"><%= game.year_of_release %></span></div>

          <a class="btn-update" href="/update/<%= game.id %>">Update</a>

          <form class="delete-game" action="/delete/<%= game.id %>" method="post">
            <button type="submit" onclick="return confirm('Are you sure you want to delete this game?')">Delete</button>
          </form>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>