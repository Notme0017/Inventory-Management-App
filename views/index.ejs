<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=title%></title>
</head>
<body>
  <h1><%= title %></h1>

  <%-include('partials/nav')%>

  <ul>
    <% games.forEach((game) =>{ %>
      <li>
        <div><%=game.title%></div>
        <div><span>Genre: </span> <span><%=game.genre%></span></div>
        <div><span>Developer: </span><span><%=game.developer%></span></div>
        <div><span>Year: </span><span><%=game.year_of_release%></span></div>
        <a href="/update/<%=game.id%>">Update</a>
        
        <form action="/delete/<%=game.id%>" method="post">
          <button type="submit" onclick="return confirm(`Are you sure you want to delete this game?`)">Delete</button>
        </form>
      </li>
    <%});%>
  </ul>
</body>
</html>