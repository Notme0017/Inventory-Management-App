<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%=title%></title>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <h1><%= title %></h1>
    <%- include('partials/errors') %>

    <form class="form-card" action="/genres/add" method="post">
      <label for="genre">Genre</label>
      <input type="text" name="genre" id="genre" required maxlength="255">

      <button type="submit">Add</button>
    </form>
  </main>
</body>
</html>