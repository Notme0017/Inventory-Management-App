<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%=title%></title>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <h1><%= title %></h1>
    <%- include('partials/errors') %>

    <% genres.forEach(genre => { %>
      <section class="genre-box">
        <div class="genre-header">
          <h2 class="genre-name"><%= genre.name %></h2>

          <% if (genre.games.length === 0) { %>
            <form class="delete-genre" action="/genres/delete/<%= genre.id %>" method="post">
              <button type="submit" onclick="return confirm('Delete this genre?')">Delete Genre</button>
            </form>
          <% } %>
        </div>

        <% if (genre.games.length === 0) { %>
          <p class="empty">No games in this genre.</p>
        <% } else { %>
          <ul class="genre-games">
            <% genre.games.forEach(game => { %>
              <li>
                <span><%= game.title %> (<%= game.year_of_release %>)</span>
                <form class="delete-game" action="/delete/<%= game.id %>" method="post">
                  <button type="submit" onclick="return confirm('Are you sure you want to delete this game?')">Delete</button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    <% }) %>
  </main>
</body>
</html>