<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=title%></title>
</head>
<body>
  <h1><%=title%></h1>
  <%-include("partials/errors.ejs") %>
  <form action="/update/<%=game.id%>" method="post">
    <label for="title">Title: </label>
    <input type="text" name="title" id="title" value="<%=game.title%>" required>
    <%-include("partials/genre", {genres: genres})%>
    <label for="developer">Developer: </label>
    <input type="text" name="developer" id="developer" value="<%=game.developer%>" required>
    <label for="year_of_release">Year: </label>
    <input type="number" name="year_of_release" id="year_of_release" min="1900" value="<%=game.year_of_release%>" required>
    <button type="submit">Submit</button>
  </form>
</body>
</html>